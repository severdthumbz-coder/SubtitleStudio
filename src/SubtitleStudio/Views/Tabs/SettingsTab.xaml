<UserControl x:Class="SubtitleStudio.Views.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:SubtitleStudio.Infrastructure"
             xmlns:ctl="clr-namespace:SubtitleStudio.Views.Controls">
    <!-- Settings. Logic: MainViewModel.Settings.cs + ApiKeyEntryViewModel + SettingsService / ApiKeyStore. Auto-saves. -->
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: categories -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource Text.H1}" Margin="4,0,0,14" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,12,0,0">
                <TextBlock Text="&#xE74E;" Style="{StaticResource Text.Icon}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" />
                <TextBlock Text="Changes save automatically." Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <ListBox Style="{StaticResource NavList}"
                     ItemsSource="{Binding SettingsCategories}"
                     SelectedValuePath="Key"
                     SelectedValue="{Binding SelectedSettingsCategory, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15" Margin="0,0,11,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: content -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,12,16">

                <!-- ================= API keys ================= -->
                <StackPanel Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqVis}, ConverterParameter=keys}">
                    <TextBlock Text="AI and service API keys" Style="{StaticResource Text.H1}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,16"
                               Text="Keys are encrypted with Windows DPAPI for your Windows account before they are written to subt_settings.json. They are never stored in plain text and are shown masked once saved." />

                    <ItemsControl ItemsSource="{Binding ApiKeyEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="{StaticResource Radius.Pill}" Padding="10,2,10,3"
                                                    BorderThickness="1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Saved">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Unreadable">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,4,0,14" />

                                        <!-- Locked view: mask + Edit / Remove -->
                                        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                                <Button Tag="&#xE785;" Content="{Binding EditButtonText}" Command="{Binding EditCommand}"
                                                        ToolTip="Unlock the field to enter or change the key" />
                                                <Button Style="{StaticResource DangerButton}" Tag="&#xE74D;" Content="Remove" Margin="8,0,0,0"
                                                        Command="{Binding RemoveCommand}"
                                                        Visibility="{Binding HasKey, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource Brush.InputBackground}" BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="10,6" MinHeight="32">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" FontSize="13" Margin="0,0,9,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                                                <Setter Property="Text" Value="&#xE785;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE72E;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding MaskedValue}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </DockPanel>
                                            </Border>
                                        </DockPanel>

                                        <!-- Unlocked view: PasswordBox + Save / Cancel -->
                                        <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                                <Button Style="{StaticResource AccentButton}" Tag="&#xE74E;" Content="Save" Command="{Binding SaveCommand}" />
                                                <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
                                            </StackPanel>
                                            <PasswordBox inf:PasswordBoxHelper.BoundPassword="{Binding PendingKey, Mode=TwoWay}"
                                                         ToolTip="Paste the API key. It is encrypted as soon as you press Save." />
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{Binding Message, Converter={StaticResource Vis}}">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="13"
                                                       Foreground="{DynamicResource Brush.Warning}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Muted}" MaxWidth="700" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="15"
                                       Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" Margin="0,1,12,0" />
                            <StackPanel>
                                <TextBlock Text="Moving the portable folder?" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                           Text="DPAPI keys only decrypt for the same Windows account on the same PC. Everything else in subt_settings.json travels with the folder; on a new PC you will be asked to re-enter keys. More providers (OpenSubtitles, DeepL, ElevenLabs, Azure) get their own cards here as their engines are added." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Engines & tools ================= -->
                <StackPanel Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqVis}, ConverterParameter=engines}">
                    <TextBlock Text="Engines and tools" Style="{StaticResource Text.H1}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,16"
                               Text="External programs Subtitle Studio drives. Nothing is installed; point to your own copies or drop them next to SubtitleStudio.exe." />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ffmpeg" Style="{StaticResource Text.H2}" />
                                <ctl:HintMarker Margin="8,0,0,0"
                                                Text="Search order: the path set here (file or folder), then next to SubtitleStudio.exe (also .\ffmpeg, .\ffmpeg\bin, .\tools), then PATH. ffprobe.exe must sit next to ffmpeg.exe." />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,12"
                                       Text="Reads durations (ffprobe), extracts audio for transcription and muxes dubbed audio. Leave empty to auto-detect." />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Tag="&#xE838;" Content="Browse" Command="{Binding BrowseFfmpegCommand}" />
                                    <Button Tag="&#xE72C;" Content="Re-detect" Command="{Binding DetectFfmpegCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Full path to ffmpeg.exe or its folder. Empty = auto-detect." />
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" FontSize="13" Margin="0,1,8,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FfmpegReady}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding FfmpegStatusText}" Style="{StaticResource Text.Muted}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AI Transcribe (Whisper)" Style="{StaticResource Text.H2}" />
                                <ctl:HintMarker Margin="8,0,0,0"
                                                Text="whisper.cpp runs inside the app: no other program is needed (except FFmpeg, to read the audio). Models are downloaded in the AI Transcribe tab and kept in models\whisper next to the app." />
                            </StackPanel>
                            <TextBlock Text="Runs on" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
                            <ComboBox ItemsSource="{Binding WhisperDeviceOptions}" SelectedItem="{Binding SelectedWhisperDevice, Mode=TwoWay}" Width="380" HorizontalAlignment="Left"
                                      ToolTip="Automatic uses the graphics card through Vulkan. A change takes effect after restarting the app." />
                            <TextBlock Text="{Binding WhisperDeviceText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE838;" Content="Models folder" Command="{Binding OpenWhisperModelsFolderCommand}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding WhisperModelsFolder}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="Which engine" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Ask again" Command="{Binding ForgetEngineChoiceCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding HasRememberedEngine, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding RememberedEngineText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Graphics card" Style="{StaticResource Text.H2}" />
                                <ctl:HintMarker Margin="8,0,0,0"
                                                Text="Detected automatically. NVIDIA, AMD and Intel GPUs all accelerate AI fill through DirectML, built into the app. Without a usable GPU it runs on the processor, which is much slower." />
                            </StackPanel>
                            <TextBlock Text="{Binding GpuSummary}" Style="{StaticResource Text.Body}" Margin="0,8,0,8" />
                            <ItemsControl ItemsSource="{Binding GpuAdapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,2">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  &#x00B7;  " /><Run Text="{Binding Vendor, Mode=OneWay}" /><Run Text="  &#x00B7;  " /><Run Text="{Binding MemoryText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="This PC" Style="{StaticResource Text.H2}" />
                                <ctl:HintMarker Margin="8,0,0,0"
                                                Text="Detected at start. Processor threads decide how many frames are cleaned at once; free memory limits how many frames are held at once; graphics memory decides how many patches AI fill sends per call. The drive type matters little for speed; free space and network or USB drives are checked before Create video." />
                            </StackPanel>
                            <TextBlock Text="{Binding HardwareCpuText}" Style="{StaticResource Text.Body}" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding HardwareRamText}" Style="{StaticResource Text.Body}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding HardwareAppDriveText}" Style="{StaticResource Text.Body}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding HardwarePlanText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Output defaults ================= -->
                <StackPanel Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqVis}, ConverterParameter=output}">
                    <TextBlock Text="Output defaults" Style="{StaticResource Text.H1}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,16"
                               Text="Used when saving new subtitle files. You can still choose per file when saving." />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Subtitle format" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MaxWidth="340" HorizontalAlignment="Left" MinWidth="280"
                                      ItemsSource="{Binding OutputFormats}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                      SelectedValue="{Binding DefaultOutputFormat, Mode=TwoWay}" />

                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock Text="Language code" VerticalAlignment="Center" />
                                <ctl:HintMarker Margin="6,0,0,0" Text="ISO 639 code used in sidecar names, e.g. en, fr, de, pt-br." />
                            </StackPanel>
                            <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,14,0,0"
                                     Text="{Binding DefaultLanguage, UpdateSourceTrigger=LostFocus}" />

                            <TextBlock Grid.Row="2" Text="Sidecar names" VerticalAlignment="Top" Margin="0,16,0,0" />
                            <Border Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" Padding="12,9" HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.InputBackground}" CornerRadius="{StaticResource Radius.Control}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding SidecarPreview}" Style="{StaticResource Text.Mono}" LineHeight="20" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                               Text="VideoName.lang[.forced][.hi].ext, so Plex and Jellyfin pair them automatically." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ================= Behaviour ================= -->
                <StackPanel Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqVis}, ConverterParameter=behaviour}">
                    <TextBlock Text="Behaviour" Style="{StaticResource Text.H1}" Margin="0,0,0,16" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IncludeSubfolders}">
                                <StackPanel>
                                    <TextBlock Text="Include subfolders when adding a folder" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Applies to Add folder, drag and drop and hand-off." />
                                </StackPanel>
                            </CheckBox>
                            <Separator />
                            <CheckBox IsChecked="{Binding BringToFrontOnHandoff}">
                                <StackPanel>
                                    <TextBlock Text="Bring the window to the front when Video Metadata Editor sends a file" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="When off, hand-offs are added quietly in the background." />
                                </StackPanel>
                            </CheckBox>
                            <Separator />
                            <CheckBox IsChecked="{Binding RestoreSessionAfterCrash}">
                                <StackPanel>
                                    <TextBlock Text="Offer to restore my session after a crash" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                               Text="While you work, your files, Detect results, settings and unsaved subtitle edits are saved every few seconds to subt_session.json next to the app. If the app or the PC stops unexpectedly, the next start offers them back and can restart an interrupted Create video or Extract. A normal close deletes the file." />
                                </StackPanel>
                            </CheckBox>
                            <Separator />
                            <CheckBox IsChecked="{Binding ShowHints}">
                                <StackPanel>
                                    <TextBlock Text="Show (i) hints" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Small info markers next to options that explain what they do." />
                                </StackPanel>
                            </CheckBox>
                            <Separator />
                            <CheckBox IsChecked="{Binding ShowGuidedTourOnFirstRun}">
                                <StackPanel>
                                    <TextBlock Text="Show the guided tour on first run" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Master switch for the onboarding tour. The tour itself arrives in a later build." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Appearance ================= -->
                <StackPanel Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqVis}, ConverterParameter=appearance}">
                    <TextBlock Text="Appearance" Style="{StaticResource Text.H1}" Margin="0,0,0,16" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock Text="Theme" Width="180" VerticalAlignment="Center" />
                            <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding Theme, Mode=TwoWay}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Storage ================= -->
                <StackPanel Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource EqVis}, ConverterParameter=storage}">
                    <TextBlock Text="Storage" Style="{StaticResource Text.H1}" Margin="0,0,0,16" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Settings file" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding SettingsFilePath, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                     FontFamily="{StaticResource Font.Mono}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SettingsStorageText}" Style="{StaticResource Text.Muted}" Margin="0,10,0,14" />
                            <Button HorizontalAlignment="Left" Tag="&#xE838;" Content="Show in Explorer" Command="{Binding OpenSettingsFolderCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
