<UserControl x:Class="SubtitleStudio.Views.Tabs.DubbingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SubtitleStudio.Views.Controls"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:vm="clr-namespace:SubtitleStudio.ViewModels"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <!-- Dubbing. Logic: MainViewModel.Dubbing.cs + Services/Dubbing (Kokoro in the app). -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Dubbing" Style="{StaticResource Text.H1}" VerticalAlignment="Center" />
            <ctl:HintMarker Margin="8,2,0,0"
                            Text="Speaks English subtitles with an AI voice (Kokoro) running inside the app: nothing is uploaded and no other program is needed. Each line is spoken when its subtitle appears, fitted into its time, and can have a voice per speaker. The original voices are then taken out under the English lines (music and effects kept), or the original sound is turned down while the voice speaks; the result is added to a copy of the video as an extra English audio track. The original video is never changed." />
        </StackPanel>

        <!-- ================= Left: steps ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1. Voice model" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="Kokoro v1.0 (82 million parameters, Apache-2.0) and its voices, 337 MB in models\tts next to the app. Downloaded once from the kokoro-onnx project on GitHub and checked against sizes and SHA-256 written into the app. An interrupted download continues where it stopped." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,8"
                                   Text="{Binding TtsModel.Description}" />
                        <WrapPanel>
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE896;" Content="{Binding DownloadTtsModelLabel}" Command="{Binding DownloadTtsModelCommand}" Margin="0,0,8,6"
                                    ToolTip="Downloads from github.com and checks it" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE838;" Content="Models folder" Command="{Binding OpenTtsModelsFolderCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DubbingDeviceText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding HasTtsModel, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="2. Voice" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="27 English voices, female and male, American and British; the recommended ones are the clearest. British voices use American pronunciations for now. Preview speaks the line below: the line selected in the Subtitles tab, or anything you type." />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding DubbingVoices}" SelectedItem="{Binding SelectedDubbingVoice, Mode=TwoWay}" Margin="0,10,0,4"
                                  IsEnabled="{Binding HasTtsModel}" />
                        <TextBlock Text="{Binding SelectedDubbingVoice.Note}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="Speed" Style="{StaticResource Text.Label}" Margin="0,4,0,4" />
                        <ComboBox ItemsSource="{Binding DubbingSpeeds}" SelectedItem="{Binding SelectedDubbingSpeed, Mode=TwoWay}" IsEnabled="{Binding HasTtsModel}" />
                        <TextBlock Text="Line to hear" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="40" MaxHeight="100"
                                 VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE768;" Content="Preview" Command="{Binding PreviewVoiceCommand}" Margin="0,0,8,6"
                                    ToolTip="Speaks the line in the chosen voice and speed (the first time also loads the voice model)" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE71A;" Content="Stop" Command="{Binding StopPreviewCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE8C8;" Content="Selected line" Command="{Binding UseSelectedLineCommand}" Margin="0,0,0,6"
                                    ToolTip="Puts the line selected in the Subtitles tab here again" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="3. What to speak" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="Every line is spoken and placed when its subtitle appears. Sound labels like [door closes] and song lines are left out. A line that takes longer than the time before the next one is said faster, up to 30% faster than the chosen speed; if that isn't enough it is also made up to 15% shorter, with its pitch kept. A line that still doesn't fit is reported, and the line after waits for it rather than being spoken over it." />
                        </StackPanel>
                        <TextBlock Text="{Binding DubbingSourceText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DubbingLanguageWarning}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding HasDubbingLanguageWarning, Converter={StaticResource Vis}}" />
                        <CheckBox Content="Fit lines into their time" IsChecked="{Binding DubbingFit, Mode=TwoWay}" Margin="0,10,0,0"
                                  ToolTip="Lines too long for the time before the next one are said faster (and, if needed, a little shorter)" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Speakers" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="Listens to the video and tells the people apart by their voices (a voiceprint of each line, lines that sound alike grouped together), guesses male or female from the pitch, and gives each person a different voice of that gender, the best voices to whoever speaks most. Check the result: rename people, correct the gender or voice, join two that are the same person, or change who speaks the selected line. The people are remembered for the show (speakers folder next to the app), so the same person keeps the same voice in the next episodes. The first time, a 26 MB voiceprint model is downloaded from the sherpa-onnx project on GitHub (WeSpeaker, CC BY 4.0)." />
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE716;" Content="Find the speakers" Command="{Binding FindSpeakersCommand}" Margin="0,0,8,6"
                                    ToolTip="Listens to the paired video (a minute or two for an episode)" />
                            <CheckBox Content="A voice for each speaker" IsChecked="{Binding DubbingPerSpeaker, Mode=TwoWay}" IsEnabled="{Binding HasSpeakers}" VerticalAlignment="Center" Margin="0,0,8,6"
                                      ToolTip="Off: everyone is dubbed in the voice chosen in step 2" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE74D;" Content="Forget the show's speakers" Command="{Binding ForgetShowSpeakersCommand}" Margin="0,0,0,6"
                                    ToolTip="Clears the names and voices remembered for this show" />
                        </WrapPanel>
                        <CheckBox Content="Ask me to confirm a speaker whose pitch is borderline" IsChecked="{Binding DubbingConfirmGender, Mode=TwoWay}" Margin="0,0,0,2"
                                  ToolTip="When a speaker's pitch is in the range where a higher-voiced man and a lower-voiced woman overlap (about 140–185 Hz), the speaker is marked &quot;check gender&quot; so you can confirm it. Off: the pitch decides, as before." />
                        <TextBlock Text="{Binding SpeakersStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <ItemsControl ItemsSource="{Binding SpeakerRows}" Visibility="{Binding HasSpeakers, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                        <StackPanel>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontWeight="SemiBold" ToolTip="The speaker's name (kept for the show)" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,5" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5" Visibility="{Binding GenderUncertain, Converter={StaticResource Vis}}">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="Check gender: the pitch is borderline (a higher-voiced man or lower-voiced woman). Play the line and set it." Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{x:Static vm:SpeakerRowViewModel.Genders}" SelectedItem="{Binding Gender, Mode=TwoWay}" ToolTip="Male or female (guessed from the pitch)" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice, Mode=TwoWay}" ToolTip="The voice this person is dubbed with" />
                                            </Grid>
                                            <DockPanel Margin="0,6,0,0">
                                                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE767;" Content="Original" Command="{Binding HearOriginalCommand}" Margin="0,0,4,0"
                                                        ToolTip="Plays this person's longest line from the video" />
                                                <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE768;" Content="Dub voice" Command="{Binding HearVoiceCommand}" Margin="0,0,8,0"
                                                        ToolTip="Says one of this person's lines in their dub voice" />
                                                <TextBlock DockPanel.Dock="Left" Text="Same as" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <ComboBox ItemsSource="{Binding Others}" SelectedItem="{Binding SameAs, Mode=TwoWay}" ToolTip="The same person as another speaker: choose them and the two are joined" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasSpeakers, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                            <TextBlock Text="Who speaks the line selected in the Subtitles tab:" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedLineText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SpeakerRows}" SelectedItem="{Binding SelectedLineSpeaker, Mode=TwoWay}" ToolTip="Change who speaks the line selected in the Subtitles tab" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="4. Into the video" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="Removed: the voices are separated from the video's first audio track by an AI model in the app (UVR MDX-Net, 56 MB, downloaded the first time; by the Ultimate Vocal Remover project), and taken out where each English line goes. Elsewhere the sound is untouched, so laughs, gasps and voices without subtitles stay. Each English line is as loud as the voice it replaces and on the same side. The other choices turn the whole original sound down while the voice speaks. The mix is added as a new English audio track (AAC, stereo) to a copy of the video; picture, the original audio and the subtitles are copied as they are. Needs ffmpeg (Settings > Engines &amp; tools)." />
                        </StackPanel>
                        <TextBlock Text="The original voices" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding DubbingDuckOptions}" SelectedItem="{Binding SelectedDubbingDuck, Mode=TwoWay}" />
                        <TextBlock Text="{Binding DubbingDuckHelp}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <CheckBox Content="Make the English voice-over the default audio track" IsChecked="{Binding DubbingDefaultTrack, Mode=TwoWay}" Margin="0,10,0,6"
                                  ToolTip="Players start with it; the original sound stays one click away. Off: the original stays the default." />
                        <CheckBox Content="Smaller file (lower quality, re-encodes the picture)" IsChecked="{Binding DubbingSmallFile, Mode=TwoWay}" Margin="0,0,0,10"
                                  ToolTip="The picture is re-encoded at most 720 lines high, a quarter to a third the size of a 1080p original, saved as &quot;(English dub, small)&quot;. Off: the picture is copied as-is (same quality, full size). Takes longer, as the video is re-encoded." />
                        <WrapPanel>
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE714;" Content="Make the dubbed video..." Command="{Binding MakeDubbedVideoCommand}" Margin="0,0,8,6"
                                    ToolTip="Speaks every line, puts it in place of the original voices (or over the lowered sound) and saves a copy of the video with the extra English track" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE720;" Content="Voice track only (WAV)..." Command="{Binding MakeVoiceTrackCommand}" Margin="0,0,0,6"
                                    ToolTip="Just the spoken lines, as a WAV as long as the video, to mix elsewhere" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DubbedVideoBlockedText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Right: progress, the preview player, what's next ================= -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelDubbingCommand}"
                                Visibility="{Binding DubbingBusy, Converter={StaticResource Vis}}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding DubbingStatus}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   ToolTip="{Binding DubbingStatus}" />
                    </DockPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DubbingProgress, Mode=OneWay}" Margin="0,10,0,0"
                                 Visibility="{Binding DubbingBusy, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding DubbingReport}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding HasDubbingReport, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <!-- Hear the dub: a stretch spoken, mixed and played here, nothing saved -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="200" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hear the dub" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="Speaks only the lines in a short stretch, with the voice, speed, fitting and level chosen on the left, mixes them over the original sound exactly as the dubbed video will be, and plays the result here with the picture. Nothing is saved. Change something and preview again to compare." />
                        </StackPanel>
                        <TextBlock Text="{Binding DubPreviewStartText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding DubPreviewLengths}" SelectedItem="{Binding SelectedDubPreviewLength, Mode=TwoWay}" MinWidth="130" Margin="0,0,8,6" VerticalAlignment="Center" />
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE768;" Content="Preview the dub" Command="{Binding PreviewDubCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DubbedVideoBlockedText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DubPreviewText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,6"
                                   Visibility="{Binding HasDubPreview, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#FF000000" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Visibility="{Binding HasDubPreview, Converter={StaticResource Vis}}">
                        <vlc:VideoView x:Name="PreviewView" />
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,8,0,0" DataContext="{Binding DubPlayer}"
                               Visibility="{Binding DataContext.HasDubPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}">
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE892;" Command="{Binding BackCommand}" ToolTip="2 s back" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Tag="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Margin="4,0" ToolTip="Play / pause" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE893;" Command="{Binding ForwardCommand}" ToolTip="2 s forward" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Tag="&#xE72C;" Command="{Binding RestartCommand}" Margin="4,0,0,0" ToolTip="From the start of the stretch" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Slider Minimum="0" Maximum="{Binding LengthSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Still to come for dubbing" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="Subtitles placed where the speech really is (some lines are timed early when the original voice is quiet or in the background)." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
