<UserControl x:Class="SubtitleStudio.Views.Tabs.DubbingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SubtitleStudio.Views.Controls">
    <!-- Dubbing. Logic: MainViewModel.Dubbing.cs + Services/Dubbing (Kokoro in the app). -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Dubbing" Style="{StaticResource Text.H1}" VerticalAlignment="Center" />
            <ctl:HintMarker Margin="8,2,0,0"
                            Text="Speaks English subtitles with an AI voice (Kokoro) running inside the app: nothing is uploaded and no other program is needed. This first dubbing build makes one English voice track, a WAV file with each line spoken when its subtitle appears. Fitting long lines into their time, mixing the voice over the original sound and adding it to the video come in the next builds." />
        </StackPanel>

        <!-- ================= Left: steps ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1. Voice model" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="Kokoro v1.0 (82 million parameters, Apache-2.0) and its voices, 337 MB in models\tts next to the app. Downloaded once from the kokoro-onnx project on GitHub and checked against sizes and SHA-256 written into the app. An interrupted download continues where it stopped." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,8"
                                   Text="{Binding TtsModel.Description}" />
                        <WrapPanel>
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE896;" Content="{Binding DownloadTtsModelLabel}" Command="{Binding DownloadTtsModelCommand}" Margin="0,0,8,6"
                                    ToolTip="Downloads from github.com and checks it" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE838;" Content="Models folder" Command="{Binding OpenTtsModelsFolderCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DubbingDeviceText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding HasTtsModel, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="2. Voice" Style="{StaticResource Text.H2}" />
                            <ctl:HintMarker Margin="8,0,0,0"
                                            Text="27 English voices, female and male, American and British; the recommended ones are the clearest. British voices use American pronunciations for now. Preview speaks the line below: the line selected in the Subtitles tab, or anything you type." />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding DubbingVoices}" SelectedItem="{Binding SelectedDubbingVoice, Mode=TwoWay}" Margin="0,10,0,4"
                                  IsEnabled="{Binding HasTtsModel}" />
                        <TextBlock Text="{Binding SelectedDubbingVoice.Note}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="Speed" Style="{StaticResource Text.Label}" Margin="0,4,0,4" />
                        <ComboBox ItemsSource="{Binding DubbingSpeeds}" SelectedItem="{Binding SelectedDubbingSpeed, Mode=TwoWay}" IsEnabled="{Binding HasTtsModel}" />
                        <TextBlock Text="Line to hear" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="40" MaxHeight="100"
                                 VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE768;" Content="Preview" Command="{Binding PreviewVoiceCommand}" Margin="0,0,8,6"
                                    ToolTip="Speaks the line in the chosen voice and speed (the first time also loads the voice model)" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE71A;" Content="Stop" Command="{Binding StopPreviewCommand}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource GhostButton}" Tag="&#xE8C8;" Content="Selected line" Command="{Binding UseSelectedLineCommand}" Margin="0,0,0,6"
                                    ToolTip="Puts the line selected in the Subtitles tab here again" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="3. Voice track" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{Binding DubbingSourceText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DubbingLanguageWarning}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding HasDubbingLanguageWarning, Converter={StaticResource Vis}}" />
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,10"
                                   Text="Every line is spoken in the chosen voice and placed when its subtitle appears, as one WAV file as long as the video. Sound labels like [door closes] and song lines are left out. A line that takes longer than the time before the next one is reported, and the next line waits for it." />
                        <WrapPanel>
                            <Button Style="{StaticResource AccentButton}" Tag="&#xE720;" Content="Make the voice track..." Command="{Binding MakeVoiceTrackCommand}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DubbingBlockedText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Right: progress and the result ================= -->
        <StackPanel Grid.Row="1" Grid.Column="2">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelDubbingCommand}"
                                Visibility="{Binding DubbingBusy, Converter={StaticResource Vis}}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding DubbingStatus}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   ToolTip="{Binding DubbingStatus}" />
                    </DockPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DubbingProgress, Mode=OneWay}" Margin="0,10,0,0"
                                 Visibility="{Binding DubbingBusy, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding DubbingReport}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding HasDubbingReport, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Coming in the next dubbing builds" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="Fitting: each line sped up or shortened to fit its time, and lines that can't be flagged. Mixing: the original sound turned down under the voice, and the result added to the video as an extra English audio track. Speakers: a different voice for each person, matching their gender, remembered across a season. Full dub: the original voices removed, the music and effects kept." />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
