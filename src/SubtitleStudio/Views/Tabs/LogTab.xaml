<UserControl x:Class="SubtitleStudio.Views.Tabs.LogTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SubtitleStudio.Views.Controls"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <!-- Log. Logic: MainViewModel.Log.cs + Services/ActivityLog (also written to subt_activity.log). -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Show details (ffmpeg commands, timings)" IsChecked="{Binding ShowLogDetails, Mode=TwoWay}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <Button Tag="&#xE8C8;" Content="Copy all" Command="{Binding CopyLogCommand}" Margin="0,0,8,0"
                        ToolTip="Copy the whole log (with details if shown) to paste into a message" />
                <Button Style="{StaticResource GhostButton}" Tag="&#xE838;" Content="Open log file" Command="{Binding OpenLogFileCommand}" Margin="0,0,8,0"
                        ToolTip="Show subt_activity.log next to the app" />
                <Button Style="{StaticResource GhostButton}" Tag="&#xE894;" Content="Clear view" Command="{Binding ClearLogViewCommand}"
                        ToolTip="Clears this list only; the log file keeps everything" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Log" Style="{StaticResource Text.H1}" VerticalAlignment="Center" />
                <ctl:HintMarker Margin="8,2,0,0"
                                Text="What the app did: every status message, each detection, extraction and removal with its settings, speed and timing, which encoder and graphics card were used, and errors. With details: the exact ffmpeg commands and their messages. Everything is also written to subt_activity.log next to the app (it starts over after 2 MB, keeping the previous file as subt_activity.old.log)." />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding LogSummary}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionMode="Extended" KeyDown="LogList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Detail">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding Area}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
