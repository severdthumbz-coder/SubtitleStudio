<Window x:Class="SubtitleStudio.Views.Dialogs.EngineChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which engine?"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        UseLayoutRounding="True">
    <!-- Shown when several engines can do a job (this PC, and online services with a saved API key). -->
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="HeadingText" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="More than one engine can do this. Choose which one to use:" />

        <ItemsControl x:Name="ChoicesList" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                        <RadioButton GroupName="Engine" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="{Binding Choice.Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Choice.Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox x:Name="RememberBox" Content="Remember my choice (change it in Settings &gt; Engines and tools)" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,8,0" Padding="14,7" Click="OnCancel" IsCancel="True" />
            <Button Style="{StaticResource AccentButton}" Content="Use this engine" Padding="14,7" Click="OnUse" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
