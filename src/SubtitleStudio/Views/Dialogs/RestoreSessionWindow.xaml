<Window x:Class="SubtitleStudio.Views.Dialogs.RestoreSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore your previous session?"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        UseLayoutRounding="True">
    <!-- After a crash: what will come back, and (if one was running) restart the interrupted job. -->
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Restore your previous session?" Style="{StaticResource Text.H2}" Margin="0,0,0,8" />
        <TextBlock x:Name="IntroText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=•  {0}}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock x:Name="JobText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="FreshButton" Style="{StaticResource GhostButton}" Content="Start fresh" Margin="0,0,8,0" Padding="14,7" Click="OnStartFresh" IsCancel="True" />
            <Button x:Name="RestoreOnlyButton" Content="Restore only" Margin="0,0,8,0" Padding="14,7" Click="OnRestoreOnly" Visibility="Collapsed" />
            <Button x:Name="RestoreButton" Style="{StaticResource AccentButton}" Content="Restore" Padding="14,7" Click="OnRestore" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
