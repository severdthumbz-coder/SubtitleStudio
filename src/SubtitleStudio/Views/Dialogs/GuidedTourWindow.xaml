<Window x:Class="SubtitleStudio.Views.Dialogs.GuidedTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guided tour"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        UseLayoutRounding="True">
    <!-- A self-contained, one-window tour: a translucent backdrop fills the owner window to focus attention, and the
         card in the centre navigates between steps (Back / Next / Skip / Finish). Each step can bring its tab forward.
         Modelled on Video Metadata Editor's tour. -->
    <Grid x:Name="Backdrop" Background="#66000000" MouseLeftButtonDown="OnBackdropClick">
        <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource Brush.Window}" CornerRadius="14" Padding="28,24,28,22"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                MouseLeftButtonDown="OnCardClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="StepLabel" Text="Step 1 of 9"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,8" />
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" FontSize="20" Margin="0,0,0,10" />
                <TextBlock x:Name="BodyText" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,22" />

                <Grid>
                    <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" Content="Skip tour"
                            Padding="14,7" HorizontalAlignment="Left" Click="OnSkip" IsCancel="True" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="&#x2190; Back"
                                Padding="14,7" Margin="0,0,8,0" Click="OnBack" />
                        <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Next &#x2192;"
                                Padding="16,7" Click="OnNext" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
