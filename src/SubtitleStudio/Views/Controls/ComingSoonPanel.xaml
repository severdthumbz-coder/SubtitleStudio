<UserControl x:Class="SubtitleStudio.Views.Controls.ComingSoonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Placeholder for tabs whose feature lands in a later build. Honest about what exists. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource Card}" MaxWidth="760" Margin="24,40,24,24" Padding="32,28"
                HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel>
                <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock Text="{Binding Glyph, ElementName=Root}" Style="{StaticResource Text.Icon}" FontSize="24"
                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                </Border>

                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Text.H1}" Margin="0,16,0,6" />
                <TextBlock Text="{Binding Summary, ElementName=Root}" Style="{StaticResource Text.Muted}" />

                <Border Margin="0,18,0,4" Padding="10,4" HorizontalAlignment="Left"
                        CornerRadius="{StaticResource Radius.Pill}" Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Text.Icon}" FontSize="12"
                                   Foreground="{DynamicResource Brush.Warning}" Margin="0,0,6,0" />
                        <TextBlock Text="Planned for a later build" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="What this tab will do" Style="{StaticResource Text.Label}" Margin="0,16,0,8" />
                <ItemsControl ItemsSource="{Binding Planned, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Text.Body}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Note, ElementName=Root}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                           Visibility="{Binding Note, ElementName=Root, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
