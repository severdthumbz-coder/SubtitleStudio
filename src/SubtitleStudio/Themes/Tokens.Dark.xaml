<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        DESIGN TOKENS - DARK (default).
        Tokens.Light.xaml must define exactly the same keys. Controls and views reference these
        ONLY via DynamicResource so the theme can switch at runtime.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#14161B" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1B1E25" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#232730" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#2A2F3A" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#12141A" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#2C313C" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#343A47" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Border" Color="#2E333E" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#454C5B" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#E7E9EE" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A7AEBC" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#737B8B" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4F8CFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#6A9EFF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3D78E8" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#334F8CFF" />

    <!-- Semantic (used by the Help > Legend too) -->
    <SolidColorBrush x:Key="Brush.Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5B83D" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#F16A6A" />
    <SolidColorBrush x:Key="Brush.Info" Color="#5CB8FF" />

    <!-- Media kinds -->
    <SolidColorBrush x:Key="Brush.KindVideo" Color="#4F8CFF" />
    <SolidColorBrush x:Key="Brush.KindAudio" Color="#B38BFA" />
    <SolidColorBrush x:Key="Brush.KindSubtitle" Color="#33C9A6" />

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#3A404D" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#56607A" />

    <!-- Stock WPF templates we don't restyle (e.g. the ScrollViewer corner square) read these. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1B1E25" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B1E25" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E7E9EE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E7E9EE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4F8CFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#737B8B" />
</ResourceDictionary>
