<!--
    OnboardingKit resources.
    Merge this FIRST in App.xaml's MergedDictionaries (before your theme dictionaries).
    The Onb* COLOUR brushes are intentionally NOT defined here — Subtitle Studio defines them in its
    Tokens.Dark.xaml / Tokens.Light.xaml (aliased to the app's own brushes), which ThemeService swaps
    at runtime. Defining dark defaults here would sit ahead of the swapped dictionary in lookup order and
    freeze the tour/legend to dark; leaving them out lets DynamicResource follow the live theme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ob="clr-namespace:OnboardingKit">

    <ob:OnbBoolToVisibilityConverter x:Key="OnbBoolVis"/>
    <ob:OnbInverseBoolConverter      x:Key="OnbInverseBool"/>

    <!-- ── Buttons used by the tour card ── -->
    <Style x:Key="OnbButtonBase" TargetType="Button">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OnbForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OnbPrimaryButton" TargetType="Button" BasedOn="{StaticResource OnbButtonBase}">
        <Setter Property="Background" Value="{DynamicResource OnbAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OnbAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnbOnAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="OnbSecondaryButton" TargetType="Button" BasedOn="{StaticResource OnbButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OnbBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnbForegroundBrush}"/>
    </Style>

    <Style x:Key="OnbLinkButton" TargetType="Button" BasedOn="{StaticResource OnbButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource OnbMutedBrush}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!--
        Same look as VME's original HintMarker style, for people who prefer a plain TextBlock
        with a rich ToolTip. Most of the time use <ob:HintMarker Hint="..."/> instead.
    -->
    <Style x:Key="HintMarker" TargetType="TextBlock">
        <Setter Property="Text" Value="&#x24D8;"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource OnbAccentBrush}"/>
        <Setter Property="Visibility"
                Value="{Binding ShowHelpers, Source={x:Static ob:OnboardingController.Current}, Converter={StaticResource OnbBoolVis}}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
    </Style>

</ResourceDictionary>
