<Application x:Class="SubtitleStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:SubtitleStudio.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 = design tokens. ThemeService swaps this entry for Tokens.Light.xaml at runtime. -->
                <ResourceDictionary Source="Themes/Tokens.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <inf:VisibilityConverter x:Key="Vis" />
            <inf:EqualsToVisibilityConverter x:Key="EqVis" />
            <inf:FrameImageConverter x:Key="FrameImage" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
